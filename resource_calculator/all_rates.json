    "step_4_hvac": {
        "description": "HVAC energy consumption and water generation rates",
        "scale": "household",
        "conditions": {
            "temperature": "Hot",
            "humidity": "Comfortable"
        },
        "energy_consumption": {
            "description": "HVAC energy consumption based on temperature",
            "unit": "wh_per_day_base",
            "wh_per_day_base": 6923.75,
            "multipliers": {
                "runtime_factor": 1,
                "duration_days": 1,
                "num_people": 0
            },
            "calculation": "base_wh_per_day * (runtime_hrs / 24) * duration_days"
        },
        "water_generation": {
            "description": "Water generation from HVAC condensation",
            "unit": "gal_per_hour_rates",
            "day_rate_gph": 0,
            "night_rate_gph": 0,
            "multipliers": {
                "runtime_factor": 1,
                "duration_days": 1,
                "num_people": 0
            },
            "calculation": {
                "day_hours": "min(hvac_runtime_hrs, 12)",
                "night_hours": "max(0, hvac_runtime_hrs - 12)",
                "total_generation": "(day_rate * day_hrs) + (night_rate * night_hrs)"
            }
        }
    },
    "step_5_solar": {
        "description": "Solar energy generation rates with environmental factors",
        "scale": "household",
        "conditions": {
            "temperature": "Hot",
            "humidity": "Comfortable",
            "sunlight": "Hi- Sunny"
        },
        "generation": {
            "description": "Daily solar energy generation",
            "unit": "kwh_per_day_base",
            "solar_capacity_kw": 5.25,
            "base_insolation_wh_per_m2": 9514,
            "environmental_factors": {
                "sunlight_factor": 1.0,
                "tilt_factor": 0.8,
                "system_efficiency": 0.9
            },
            "kwh_per_day_base": 35.96292,
            "multipliers": {
                "duration_days": 1,
                "num_people": 0
            },
            "calculation": "solar_capacity_kw * (insolation/1000) * sunlight * tilt * efficiency"
        }
    },
    "step_6_waste": {
        "description": "Waste water production rates and dump trip calculation",
        "scale": "calculated_from_water_consumption",
        "allocation_rules": {
            "description": "How consumed water becomes waste water",
            "lookup_table": {
                "description": "Values are per day for Living, and per cycle for others.",
                "unit": "gal",
                "living_cleaning": {
                    "grey": 0.625,
                    "black": 0
                },
                "cooking_dishwasher": {
                    "grey": 1.25,
                    "black": 0
                },
                "cooking_sink": {
                    "grey": 0,
                    "black": 1.125
                },
                "shower": {
                    "grey": 12,
                    "black": 0
                },
                "laundry": {
                    "grey": 4.12,
                    "black": 0
                },
                "toilet_handwashing": {
                    "grey": 0.375,
                    "black": 0
                },
                "toilet_flush": {
                    "grey": -0.4,
                    "black": 0.4
                }
            },
            "black_water_sources": {
                "toilet_flush": "toilet_flush_water * waste_lookup['toilet_flush']['black']",
                "kitchen_sink": "kitchen_faucet_water * (waste_lookup['cooking_sink']['black'] / kitchen_faucet_gal_per_meal)"
            },
            "grey_water_calculation": "total_fresh_water_consumed - total_black_water_produced"
        },
        "tank_capacities": {
            "greywater_gal": 50,
            "blackwater_gal": 45
        },
        "dump_trip_logic": {
            "description": "Calculate required dump trips from waste production",
            "formula": "max(grey_water/grey_capacity, black_water/black_capacity)",
            "calculation": "max(grey_water_produced / grey_capacity, black_water_produced / black_capacity)"
        }
    },
